;; Kanata configuration for home row mods on non-Glove80 keyboards
;; Functional match with sunaku/glove80-keymaps timing parameters
;;
;; Left hand:  A=Ctrl  S=Alt  D=Cmd  F=Shift  (CACS)
;; Right hand: J=Shift K=Cmd  L=Alt  ;=Ctrl   (SCAC)
;;
;; This matches the Glove80's effective modifiers directly -- NO pre-swap needed here.
;;
;; HISTORY (2026-10-08, orovira): a stale ByHost modifier-mapping entry
;; ("com.apple.keyboard.modifiermapping.5824-10203-0" in
;; ~/Library/Preferences/ByHost/.GlobalPreferences.<UUID>.plist) used to swap
;; Ctrl/Cmd unconditionally for anything reporting vendor 5824 / product 10203 --
;; which is BOTH the real Glove80 AND Karabiner's VirtualHIDKeyboard output
;; (kanata's own output device), since Karabiner's virtual device hardcodes those
;; same IDs. That entry is NOT visible/editable from System Settings' Modifier
;; Keys UI (it reads/writes a different, newer store) -- it was legacy/orphaned
;; and got reset to identity simply by opening that System Settings pane. With it
;; gone, kanata emits modifiers DIRECTLY (lctl -> Ctrl, lmet -> Cmd, no swap).
;; If literal Cmd/Ctrl keys ever come out swapped again, check that ByHost key:
;;   defaults -currentHost read -g "com.apple.keyboard.modifiermapping.5824-10203-0"
;; A real Glove80 plugged in DIRECTLY (bypassing kanata) will also now show its
;; raw Windows-profile GUI/Ctrl keys unswapped -- unfixed, needs its own fix later.

(defcfg
  ;; Only intercept keyboards that need Kanata home row mods
  ;; This leaves the Glove80, Razer mouse, and Karabiner Virtual HID untouched
  ;; The Glove80 handles its own home row mods in ZMK firmware
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
    "Gaming Keyboard"
  )
  ;; Process keys not defined in defsrc so they pass through unchanged
  process-unmapped-keys yes
)

;; Only define the home row mod keys -- everything else passes through
(defsrc
  a    s    d    f    j    k    l    ;
  lctl lmet rctl rmet
)

;; Timing variables matching sunaku's ZMK config (TAPPING_RESOLUTION = 150ms)
;;
;; Per-finger holding times:
;;   Pinky: 270ms (TAPPING_RESOLUTION + 120) -- slowest finger
;;   Ring:  240ms (TAPPING_RESOLUTION + 90)
;;   Middle:210ms (TAPPING_RESOLUTION + 60)
;;   Index: 180ms (TAPPING_RESOLUTION + 30)  -- fastest finger
;;
;; Typing streak decay: 150ms (TAPPING_RESOLUTION)
;;   Suppresses mods if you typed a key within the last 150ms

(defvar
  pinky-timeout 270
  ringy-timeout 240
  middy-timeout 210
  index-timeout 180
  streak-decay  150
)

;; Home row mod aliases
;; Using tap-hold-release-keys. Signature:
;;   (tap-hold-release-keys tap-timeout hold-timeout tap-action hold-action tap-keys)
;; The final list (tap-keys) is kanata's EARLY-TAP set: pressing one of those keys while a
;; home-row key is held forces the home-row key to resolve as a plain TAP (its letter) and
;; SUPPRESSES the modifier — roll/misfire protection. E.g. hold-A + Q yields "aq", NOT Ctrl+Q.
;; Each list is every non-home-row alnum key on both hands.
;; - The HOME ROW is deliberately EXCLUDED from the lists, so a held home-row mod plus another
;;   home-row key is not force-tapped and can resolve to the modifier — that is what enables
;;   home-row-mod chording (see the per-alias notes below).
;; - Otherwise the modifier fires on the per-finger hold-timeout; streak-decay keeps fast
;;   rolls as taps.

(defalias
  ;; Left hand home row mods
  ;; Note: j k l ; are EXCLUDED from the list to allow home row mod chording
  a-hrm (tap-hold-release-keys $streak-decay $pinky-timeout a lctl (1 2 3 4 5 6 7 8 9 0
    q w e r t y u i o p
    z x c v b n m , . /
    spc bspc ret tab esc del
    left right up down
    home end pgup pgdn))

  s-hrm (tap-hold-release-keys $streak-decay $ringy-timeout s lalt (1 2 3 4 5 6 7 8 9 0
    q w e r t y u i o p
    z x c v b n m , . /
    spc bspc ret tab esc del
    left right up down
    home end pgup pgdn))

  d-hrm (tap-hold-release-keys $streak-decay $middy-timeout d lmet (1 2 3 4 5 6 7 8 9 0
    q w e r t y u i o p
    z x c v b n m , . /
    spc bspc ret tab esc del
    left right up down
    home end pgup pgdn))

  ;; Shift lists hold SAME-HAND keys only: an opposite-hand key pressed and released while
  ;; F/J is held resolves to Shift at once, without waiting for index-timeout.
  f-hrm (tap-hold-release-keys $streak-decay $index-timeout f lsft (1 2 3 4 5
    q w e r t
    z x c v b
    spc bspc ret tab esc del
    left right up down
    home end pgup pgdn))

  ;; Right hand home row mods (mirror)
  ;; Note: a s d f are EXCLUDED from the list to allow home row mod chording
  j-hrm (tap-hold-release-keys $streak-decay $index-timeout j rsft (6 7 8 9 0
    y u i o p
    n m , . /
    spc bspc ret tab esc del
    left right up down
    home end pgup pgdn))

  k-hrm (tap-hold-release-keys $streak-decay $middy-timeout k rmet (1 2 3 4 5 6 7 8 9 0
    q w e r t y u i o p
    z x c v b n m , . /
    spc bspc ret tab esc del
    left right up down
    home end pgup pgdn))

  l-hrm (tap-hold-release-keys $streak-decay $ringy-timeout l ralt (1 2 3 4 5 6 7 8 9 0
    q w e r t y u i o p
    z x c v b n m , . /
    spc bspc ret tab esc del
    left right up down
    home end pgup pgdn))

  ;-hrm (tap-hold-release-keys $streak-decay $pinky-timeout ; rctl (1 2 3 4 5 6 7 8 9 0
    q w e r t y u i o p
    z x c v b n m , . /
    spc bspc ret tab esc del
    left right up down
    home end pgup pgdn))
)

;; Default layer with home row mods
(deflayer default
  @a-hrm @s-hrm @d-hrm @f-hrm @j-hrm @k-hrm @l-hrm @;-hrm
  lctl lmet rctl rmet
)
