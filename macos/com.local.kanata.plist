<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon for Kanata (system-wide, runs as root at boot).

  Kanata needs root to grab the keyboard. As a LaunchDaemon, launchd starts it
  as root directly — no sudo wrapper, no NOPASSWD rule. See README → "Kanata
  setup" for installation.

  If your username is not "andre", edit the kanata.kbd path below.
  Requires the Karabiner-DriverKit-VirtualHIDDevice driver at the pinned version
  installed by macos/install-kanata-driver.sh. Do NOT install Karabiner-Elements —
  its auto-updated driver breaks kanata. See README → "Kanata setup".

  Security note: this runs /opt/homebrew/bin/kanata as root, and the Homebrew prefix
  is user-writable on Apple Silicon — so anything running as your user could replace
  that binary and gain root at the next relaunch. Accepted on a single-user machine.
  To fully lock it down, copy kanata to a root-owned path (e.g. /usr/local/sbin) and
  point ProgramArguments there, re-copying after each `brew upgrade kanata`.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.kanata</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/kanata</string>
        <string>--cfg</string>
        <string>/Users/andre/.config/kanata/kanata.kbd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/kanata/kanata.out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/kanata/kanata.err.log</string>
</dict>
</plist>
