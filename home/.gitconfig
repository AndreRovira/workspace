[user]
	name = André Rovira
	email = github.snipping963@passmail.com

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = simple
	autoSetupRemote = true

[core]
	editor = nvim

# Local-only overrides (per-account identities, machine-specific).
# Git silently skips this if the file does not exist.
[include]
	path = ~/.config/git/local.gitconfig
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
