[user]
	name = André Rovira
	email = github.snipping963@passmail.com

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = simple
	autoSetupRemote = true

[core]
	editor = nvim

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Local-only overrides (per-account identities, machine-specific).
# Git silently skips this if the file does not exist.
# LAST on purpose — git applies values in file order and the last one wins, so
# an include placed above a section could never override it (e.g. pinning the
# credential helper to an absolute gh path on a box where PATH lacks Homebrew).
[include]
	path = ~/.config/git/local.gitconfig
